+        if not start_date or not end_date:
+            start_date = (datetime.utcnow() - timedelta(days=180)).strftime("%Y%m%d%H%M")
+            end_date = datetime.utcnow().strftime("%Y%m%d%H%M")
+
+        params = {
+            "serviceKey": self._service_key,
+            "pageNo": str(page),
