+    async def fetch_material_prices(
+        self,
+        category: str = "건축",
+        start_date: str | None = None,
+        end_date: str | None = None,
+        page: int = 1,
+        num_rows: int = 999,
+    ) -> list[dict[str, Any]]:
+        """시설공통자재 가격정보를 조회한다."""
+        operation = PRICE_OPERATIONS.get(category)
