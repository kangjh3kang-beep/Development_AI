  1. v62_9(컬럼) 이 배포되고 동의 화면이 **라이브에서 동작**하는지 확증한다
  2. 사용자 승인을 받는다(본인 계정이 대상이므로)
  3. 이 파일을 database/migrations/versions/v62_10_consent_backfill.py 로 옮기고 배포
  4. 적용 후 재조회로 확증: consent_pending=true 가 **8건**인지(사전 측정과 대조)
"""
from alembic import op
import sqlalchemy as sa

from apps.api.database.consent_backfill import BACKFILL_SQL  # noqa: E402

revision = "v62_10_consent_backfill"
down_revision = "v62_9_consent_pending"
branch_labels = None
depends_on = None


def upgrade() -> None:
    # ★멱등 — 이미 True 인 행과 동의가 생긴 행은 대상에서 빠진다(SQL 의 조건).
    op.execute(sa.text(BACKFILL_SQL))


def downgrade() -> None:
    # ★되돌리기는 «전원 False» 가 아니다 — 그러면 **원래 미완이던 사람도 통과**시킨다.
    #   이 리비전이 켠 것만 되돌릴 수는 없으므로(어느 행을 켰는지 기록하지 않는다),
    #   되돌림은 v62_9 의 downgrade(컬럼 삭제)로 한다. 여기서는 아무것도 하지 않는다.
    pass
